{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://airlock.local/schemas/golden-vector.schema.json",
  "title": "Airlock Golden Vector",
  "description": "Single golden vector shape shared by web, server, and packages/golden tests. Real vectors are added in Module 4.",
  "type": "object",
  "required": ["id", "description", "input", "expected"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "required": ["invoice", "supplier", "agent", "policy", "request", "history"],
      "properties": {
        "invoice": { "type": "object" },
        "supplier": { "type": "object" },
        "agent": { "type": "object" },
        "policy": { "type": "object" },
        "request": { "type": "object" },
        "history": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["decision", "reasonCode"],
      "properties": {
        "decision": { "type": "string", "enum": ["ALLOW", "BLOCK", "HOLD"] },
        "failedRule": { "type": ["string", "null"] },
        "reasonCode": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}